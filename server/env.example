# Server Environment Variables
# Copy this file to .env in the server directory and fill in your values

# Database
MONGO_URI=mongodb://localhost:27017/resume-ai

# JWT Secret (use a strong, random string in production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# API Keys
APIJOBS_KEY=your-apijobs-key-here

# Flask ML Service URL
FLASK_ML_SERVICE_URL=http://localhost:5000

# Server Configuration
PORT=5002
NODE_ENV=development
